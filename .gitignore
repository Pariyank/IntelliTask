client/build/
client/dist/

# --- Debug Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/npm-debug.log*
client/npm-debug.log*

# --- Operating System Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Firebase Specifics ---
